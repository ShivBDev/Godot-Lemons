[gd_scene load_steps=24 format=3]

; Downtown. A city block built around the one camera that ever looks at it.
;
; The camera is fixed in DaySimulation.tscn at (-9.89, 7.73, -9.65), pitched
; about 40 degrees down with a 62 degree vertical FOV on a 720x1280 portrait
; viewport. Worked out, the ground it can see runs from about 2.6 m to 46 m
; away, inside a wedge only about +/-18.7 degrees wide. In practice the visible
; ground is a narrow diagonal band running from roughly (3, -2) out to
; (24, 11), and the stand sits dead centre of it at (2.51, 0, -3.50).
;
; So everything that carries the identity of this place is placed inside that
; band: the shopfront block face at x = 6, the pavement furniture, and the
; facade detail. Towers further out are kept tall so they still read above the
; roofline. Nothing here is nested under a scaled parent - a child would
; inherit that scale and a 2 m window would come out 100 m tall.

[sub_resource type="StandardMaterial3D" id="MatPaving"]
albedo_color = Color(0.898, 0.867, 0.784, 1)

